{
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "plugins": ["prettier-plugin-blade", "prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": [
                "*.blade.php"
            ],
            "options": {
                "parser": "blade",
                "bladeDirectiveArgSpacing": "none",
                "bladeBlankLinesAroundDirectives": "preserve",
                "bladeInlineIntentElements": [
                    "svg",
                    "svg:*"
                ],
                "bladeKeepHeadAndBodyAtRoot": false,
                "bladeSlotClosingTag": "preserve"
            }
        }
    ]
}
